---
import "../styles/global.css";
import { to_json_ld } from "../components/event-schema";

interface Props {
  title?: string;
  description?: string;
  /** Utility/error pages: emits robots noindex and drops canonical, OG and JSON-LD. */
  noindex?: boolean;
  /**
   * Canonical path of the page. Server-rendered routes answer under more than one URL
   * (`trailingSlash: "ignore"`), so they state the one address worth indexing instead of
   * echoing whatever the visitor typed. Prerendered pages leave it out.
   */
  canonicalPath?: string;
}

const {
  title = "BlockchainWares - Software Development Company",
  description = "Software development company specializing in blockchain infrastructure, developer tooling, and enterprise software. Based in Dabrowa Gornicza, Poland.",
  noindex = false,
  canonicalPath,
} = Astro.props;

const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/assets/img/og-image.png", Astro.site);
const siteURL = Astro.site?.toString().replace(/\/$/, "") ?? "";
const logoURL = new URL("/assets/img/blockchainwares.svg", Astro.site);

const pageLanguage = "en";
const organizationID = new URL("#organization", Astro.site).href;
const websiteID = new URL("#website", Astro.site).href;
const localBusinessID = new URL("#localbusiness", Astro.site).href;
const webPageID = new URL("#webpage", canonicalURL).href;
const dateModified = new Date().toISOString();
---

<!doctype html>
<html lang={pageLanguage} data-theme="blockchainwares">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Splash gate: must run before body parses so the splash never paints on repeat visits -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('bw:intro-seen')) {
          document.documentElement.setAttribute('data-intro-seen', 'true');
        }
      } catch (e) {}
    </script>
    <style is:inline>
      html[data-intro-seen] #splash-screen { display: none !important; }
    </style>

    <meta name="description" content={description} />
    <meta name="author" content="BlockchainWares" />
    <meta name="keywords" content="blockchain development, enterprise software, EDA, event-driven architecture, distributed systems, smart contracts, database optimization, software house, Dąbrowa Górnicza, Poland" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <title>{title}</title>

    <!-- Open Graph -->
    {!noindex && (
      <Fragment>
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:site_name" content="BlockchainWares" />
      </Fragment>
    )}

    <!-- Twitter Card -->
    {!noindex && (
      <Fragment>
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
      </Fragment>
    )}

    <!-- Fonts (non-render-blocking) -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
      />
    </noscript>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Additional meta tags -->
    <meta name="theme-color" content="#4EB4FF" />
    {!noindex && (
      <Fragment>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </Fragment>
    )}

    <!-- Cache Control -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <!-- Unregister legacy service workers from previous app -->
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(r) {
          r.forEach(function(reg) { reg.unregister(); });
        });
        caches.keys().then(function(n) {
          n.forEach(function(name) { caches.delete(name); });
        });
      }
    </script>

    <!-- Schema.org JSON-LD -->
    {!noindex && (
      <Fragment>
        <script type="application/ld+json" set:html={to_json_ld({
          "@context": "https://schema.org",
          "@type": "Organization",
          "@id": organizationID,
          "name": "BlockchainWares",
          "url": siteURL,
          "logo": logoURL.href,
          "description": "Software development company specializing in blockchain infrastructure, developer tooling, and enterprise software. Based in Dabrowa Gornicza, Poland.",
          "foundingDate": "2013",
          "numberOfEmployees": {
            "@type": "QuantitativeValue",
            "value": 25
          },
          "email": "contact@blockchainwares.pl",
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer support",
            "email": "contact@blockchainwares.pl",
            "availableLanguage": ["en", "pl"]
          },
          "sameAs": ["https://pl.linkedin.com/company/blockchainwares-software-sp-z-o-o"],
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Graniczna 34B/U11",
            "addressLocality": "Dąbrowa Górnicza",
            "postalCode": "41-303",
            "addressCountry": "PL"
          }
        })} />
        <script type="application/ld+json" set:html={to_json_ld({
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": websiteID,
          "name": "BlockchainWares",
          "url": siteURL,
          "description": "Blockchain & Enterprise Software Development Company",
          "inLanguage": pageLanguage,
          "publisher": { "@id": organizationID }
        })} />
        <script type="application/ld+json" set:html={to_json_ld({
          "@context": "https://schema.org",
          "@type": "ProfessionalService",
          "@id": localBusinessID,
          "name": "BlockchainWares",
          "url": siteURL,
          "email": "contact@blockchainwares.pl",
          "description": "Software development company specializing in blockchain infrastructure, developer tooling, and enterprise software.",
          "image": logoURL.href,
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Graniczna 34B/U11",
            "addressLocality": "Dąbrowa Górnicza",
            "postalCode": "41-303",
            "addressCountry": "PL"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 50.3390,
            "longitude": 19.1770
          },
          "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "17:00"
          },
          "sameAs": ["https://pl.linkedin.com/company/blockchainwares-software-sp-z-o-o"],
          "priceRange": "$$"
        })} />
        <script type="application/ld+json" set:html={to_json_ld({
          "@context": "https://schema.org",
          "@type": "WebPage",
          "@id": webPageID,
          "url": canonicalURL.href,
          "name": title,
          "description": description,
          "isPartOf": { "@id": websiteID },
          "about": { "@id": organizationID },
          "inLanguage": pageLanguage,
          "dateModified": dateModified,
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": ogImageURL.href,
            "width": 1200,
            "height": 630
          }
        })} />
      </Fragment>
    )}
  </head>
  <body class="bg-base-100 overflow-x-hidden">
    <slot />
  </body>
</html>
