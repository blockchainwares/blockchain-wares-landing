---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const pageTitle = `${title} · Panel BlockchainWares`;

const NAV_LINKS = [
  { href: "/admin", label: "Logi ruchu" },
  { href: "/admin/events", label: "Wydarzenia" },
] as const;

const NAV_LINK_CLASS =
  "rounded-md px-2 py-1 text-sm transition-colors duration-150 hover:text-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary";

// `trailingSlash: "ignore"` wpuszcza tu obie postacie adresu.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

/** Prefiksowo, ale `/admin` tylko dokladnie — inaczej swiecilby wszedzie. */
function is_current(href: string): boolean {
  return href === "/admin"
    ? path === href
    : path === href || path.startsWith(`${href}/`);
}

// Na ekranie logowania nawigacja prowadzilaby tylko z powrotem do logowania.
const showNav = Astro.locals.isAuthenticated === true;
---

<!doctype html>
<html lang="pl" data-theme="blockchainwares" class="admin-html">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />

    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Cache-Control" content="no-store" />

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Strony formularza wydarzenia doklejają tu font landingu — panel go nie używa. -->
    <slot name="head" />

    <noscript>
      <style>
        /* Podgląd wydarzenia żyje wyłącznie w JavaScripcie. Bez niego zostaje sam
           formularz, który zapisuje się natywnym POST-em — martwy panel z
           przełącznikiem bez działania byłby gorszy niż jego brak. */
        [data-event-preview] {
          display: none;
        }
      </style>
    </noscript>

    <style is:global>
      /* Panel = interfejs narzedziowy: font systemowy (deterministyczne cyfry
         tabelaryczne), mniejsza baza i ciasniejszy interlinia niz na landingu. */
      .admin-html {
        scroll-behavior: auto;
      }

      body.admin-shell {
        font-family:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        font-size: 0.875rem;
        line-height: 1.5;
      }

      /* Kolumny liczb/timestampow musza sie wyrownywac niezaleznie od fontu. */
      .admin-tnum {
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
      }

      .admin-mono {
        font-family:
          ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
          "Liberation Mono", monospace;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1, "zero" 1;
        letter-spacing: -0.01em;
      }
    </style>
  </head>
  <body class="admin-shell bg-base-100 text-base-content antialiased">
    <a
      href="#admin-main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-4 focus:z-50 focus:rounded-md focus:border focus:border-secondary/60 focus:bg-base-200 focus:px-3 focus:py-1.5 focus:font-medium focus:text-base-content focus:outline-2 focus:outline-offset-2 focus:outline-secondary"
    >
      Przejdź do treści
    </a>

    <div class="flex min-h-dvh flex-col">
      <header class="sticky top-0 z-40 border-b border-base-300 bg-base-200">
        <div class="mx-auto flex h-14 w-full max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
          <div class="flex min-w-0 items-center gap-2 sm:gap-3">
            <a
              href="/admin"
              class="flex min-w-0 items-center gap-2 rounded-md transition-colors duration-150 hover:text-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
            >
              <img
                src="/assets/img/blockchainwares.svg"
                alt="BlockchainWares"
                class="h-6 w-auto shrink-0"
              />
              <span class="hidden truncate text-sm font-semibold sm:inline">
                BlockchainWares
              </span>
            </a>

            <span
              class="shrink-0 rounded-md border border-secondary/40 bg-secondary/10 px-1.5 py-0.5 text-[11px] font-semibold tracking-wide text-secondary uppercase"
            >
              Panel
            </span>

            {
              showNav && (
                <nav
                  aria-label="Sekcje panelu"
                  class="flex min-w-0 items-center gap-1"
                >
                  {NAV_LINKS.map((link) => (
                    <a
                      href={link.href}
                      aria-current={is_current(link.href) ? "page" : undefined}
                      class:list={[
                        NAV_LINK_CLASS,
                        is_current(link.href)
                          ? "bg-base-300 font-semibold text-secondary"
                          : "text-base-content/70",
                      ]}
                    >
                      {link.label}
                    </a>
                  ))}
                </nav>
              )
            }
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <slot name="actions" />
          </div>
        </div>
      </header>

      <main
        id="admin-main"
        class="admin-tnum mx-auto w-full max-w-7xl flex-1 px-4 py-5 sm:px-6 sm:py-6 lg:px-8"
      >
        <slot />
      </main>
    </div>
  </body>
</html>
