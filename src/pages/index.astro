---
import Layout from "../layouts/Layout.astro";
import {
  Navigation,
  Hero,
  EventBanner,
  About,
  OurWorks,
  EndUsers,
  Team,
  Career,
  Contact,
  Footer,
} from "../components";
import { to_iso_day, type TradeFairEvent } from "../components/events-data";
import { load_events } from "../lib/events";

const today_iso = to_iso_day(new Date());

// `load_events()` rzuca tylko przy pustym cache — awaria API wydarzen ma zabrac
// sam baner (renderuje null na pustej liscie), nie cala strone glowna.
let events: TradeFairEvent[] = [];
try {
  events = (await load_events()).events;
  // Odpowiedz nie zalezy od sesji ani od naglowkow zadania — brzeg moze ja
  // powtarzac zamiast wolac funkcje przy kazdym wejsciu.
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=60, stale-while-revalidate=300",
  );
} catch (cause) {
  // Render bez banera nie ma prawa zamarznac na brzegu na czas trwania okna swr.
  Astro.response.headers.set("Cache-Control", "no-store");
  console.error(
    "[index] events source failed:",
    cause instanceof Error ? cause.message : "unknown error",
  );
}

const BLOB_CYAN = "oklch(72% 0.18 215.221";

type Blob = {
  top: string;
  left: string;
  size: "sm" | "lg";
  color: string;
};

const blobs: Blob[] = [
  { top: "0%",  left: "10%", size: "lg", color: `${BLOB_CYAN} / 0.14)` },
  { top: "22%", left: "60%", size: "sm", color: `${BLOB_CYAN} / 0.10)` },
  { top: "45%", left: "5%",  size: "lg", color: `${BLOB_CYAN} / 0.11)` },
  { top: "65%", left: "55%", size: "sm", color: `${BLOB_CYAN} / 0.10)` },
  { top: "85%", left: "25%", size: "lg", color: `${BLOB_CYAN} / 0.12)` },
];

const blobSizeClass = {
  sm: "w-[800px] h-[800px] md:w-[1100px] md:h-[1100px]",
  lg: "w-[900px] h-[900px] md:w-[1200px] md:h-[1200px]",
} as const;

function blobStyle(blob: Blob): string {
  return `top: ${blob.top}; left: ${blob.left}; background: radial-gradient(circle, ${blob.color} 0%, transparent 70%);`;
}
---

<Layout>
  <noscript>
    <style is:inline>
      #splash-screen { display: none !important; }
    </style>
  </noscript>
  <!-- Static SSR Splash Screen — renders immediately without JS hydration -->
  <div
    id="splash-screen"
    aria-hidden="true"
    class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-[oklch(12%_0.042_264.695)]"
  >
    <!-- Logo SVG -->
    <svg
      class="w-28 h-28 text-[oklch(71%_0.143_215.221)] mb-6 overflow-visible"
      viewBox="0 0 376 381"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        class="splash-cube-top"
        d="M279.821,53.892 L280.041,161.35 L187.324,215.471 L95.222,161.992 L95,53.697 L187.324,0 L279.821,53.892 Z M124,55.4245884 L187.82302,94.1626305 L251.646039,55.4245884 L187.753367,18 L124,55.4245884 Z M194.410644,185.257007 L259.870283,149.353672 L258.233664,74.7122942 L193.876683,111.332677 L194.410644,185.257007 Z M110.548129,74.7122942 L108.91151,149.353672 L174.371148,185.257007 L174.835456,111.212035 L110.548129,74.7122942 Z"
        fill="currentColor"
        style="opacity:0;animation:splash-cube-top 0.8s cubic-bezier(0.16,1,0.3,1) 0s forwards;"
      />
      <path
        class="splash-cube-bottom-left"
        d="M184.821,218.892 L185.041,326.35 L92.324,380.471 L0.222,326.992 L0,218.697 L92.324,165 L184.821,218.892 Z M29,220.424588 L92.8230196,259.162631 L156.646039,220.424588 L92.7533667,183 L29,220.424588 Z M99.4106443,350.257007 L164.870283,314.353672 L163.233664,239.712294 L98.8766834,276.332677 L99.4106443,350.257007 Z M15.5481286,239.712294 L13.9115098,314.353672 L79.3711482,350.257007 L79.8354562,276.212035 L15.5481286,239.712294 Z"
        fill="currentColor"
        style="opacity:0;animation:splash-cube-bottom-left 0.8s cubic-bezier(0.16,1,0.3,1) 0.05s forwards;"
      />
      <path
        class="splash-cube-bottom-right"
        d="M374.821,218.892 L375.041,326.35 L282.324,380.471 L190.222,326.992 L190,218.697 L282.324,165 L374.821,218.892 Z M219,220.424588 L282.82302,259.162631 L346.646039,220.424588 L282.753367,183 L219,220.424588 Z M289.410644,350.257007 L354.870283,314.353672 L353.233664,239.712294 L288.876683,276.332677 L289.410644,350.257007 Z M205.548129,239.712294 L203.91151,314.353672 L269.371148,350.257007 L269.835456,276.212035 L205.548129,239.712294 Z"
        fill="currentColor"
        style="opacity:0;animation:splash-cube-bottom-right 0.8s cubic-bezier(0.16,1,0.3,1) 0.1s forwards;"
      />
    </svg>

    <!-- Typewriter company name -->
    <div
      class="flex items-center justify-center text-[1.75rem] font-bold tracking-wide font-[Quicksand,system-ui,sans-serif]"
    >
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.1s forwards;">B</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.16s forwards;">l</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.22s forwards;">o</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.28s forwards;">c</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.34s forwards;">k</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.4s forwards;">c</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.46s forwards;">h</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.52s forwards;">a</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.58s forwards;">i</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(96%_0.007_247.896)]" style="animation:splash-letter 0.08s ease-out 1.64s forwards;">n</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(71%_0.143_215.221)]" style="animation:splash-letter 0.08s ease-out 1.7s forwards;">W</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(71%_0.143_215.221)]" style="animation:splash-letter 0.08s ease-out 1.76s forwards;">a</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(71%_0.143_215.221)]" style="animation:splash-letter 0.08s ease-out 1.82s forwards;">r</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(71%_0.143_215.221)]" style="animation:splash-letter 0.08s ease-out 1.88s forwards;">e</span>
      <span class="inline-block max-w-0 overflow-hidden whitespace-nowrap text-[oklch(71%_0.143_215.221)]" style="animation:splash-letter 0.08s ease-out 1.94s forwards;">s</span>
      <span class="inline-block text-[oklch(71%_0.143_215.221)] ml-0.5" style="animation:splash-blink 0.8s step-end infinite 1.1s;">|</span>
    </div>

    <!-- Inline script — NOT type="module" to execute immediately -->
    <script is:inline>
      (function() {
        var splash = document.getElementById('splash-screen');
        if (!splash) return;

        function markSeen() {
          try { sessionStorage.setItem('bw:intro-seen', '1'); } catch (e) {}
        }

        // Already played in this browser session — CSS in <head> keeps it hidden
        if (document.documentElement.hasAttribute('data-intro-seen')) {
          splash.remove();
          return;
        }

        // Respect prefers-reduced-motion
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducedMotion) {
          splash.style.display = 'none';
          markSeen();
          return;
        }

        // Block scroll during splash
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';

        var finished = false;
        function finish() {
          if (finished) return;
          finished = true;
          splash.remove();
          markSeen();
          document.body.style.overflow = '';
          document.documentElement.style.overflow = '';
        }

        // Schedule fade out after 2.5s; hold_splash() in tests/navigation_scroll_lock.spec.ts
        // recognises this timer by its exact 2500 ms delay
        setTimeout(function() {
          splash.style.transition = 'opacity 0.5s ease-in-out';
          splash.style.opacity = '0';

          splash.addEventListener('transitionend', finish, { once: true });
          // transitionend never fires in a background tab or without a running
          // transition, and the scroll lock must not outlive the splash.
          setTimeout(finish, 1000);
        }, 2500);
      })();
    </script>
  </div>

  <Navigation client:load />

  <div class="relative bg-base-100 overflow-clip">
    <div class="absolute inset-0 pointer-events-none z-0">
      {blobs.map((blob) => (
        <div
          class={`absolute ${blobSizeClass[blob.size]} blob-contained`}
          style={blobStyle(blob)}
        />
      ))}
    </div>

    <div class="relative z-[1]">
      <Hero client:load />
      <EventBanner client:visible events={events} todayIso={today_iso} />
      <About client:visible />
      <OurWorks client:visible />
      <EndUsers client:visible />
      <Team client:visible />
      <Career client:visible />
      <Contact client:visible />
      <Footer />
    </div>
  </div>
</Layout>
