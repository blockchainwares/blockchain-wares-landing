---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { EventsTable } from "../../../components/admin";
import { format_panel_clock } from "../../../components/admin/clock";
import { BUTTON_CLASS } from "../../../components/admin/styles";
import type { TradeFairEvent } from "../../../components/events-data";
import {
  ADMIN_EVENTS_PATH,
  get_events_source_status,
  load_events,
  read_event_notice,
  type EventActionKind,
  type EventsSourceStatus,
} from "../../../lib/events";

export const prerender = false;

const CREATE_HREF = `${ADMIN_EVENTS_PATH}/new`;

const NOTICE_MESSAGE: Record<EventActionKind, string> = {
  created: "Wydarzenie zostało dodane.",
  updated: "Wydarzenie zostało zaktualizowane.",
  deleted: "Wydarzenie zostało usunięte.",
};

const SOURCE_ERROR =
  "Nie udało się pobrać wydarzeń z API, a panel nie ma ich kopii w pamięci — nie ma czego pokazać. To awaria odczytu: nic nie zostało usunięte.";
const STALE_WARNING =
  "Nie udało się odświeżyć wydarzeń z API — poniżej ostatnie pobrane dane. Zapis sprzed chwili może być tu jeszcze niewidoczny.";

const MINUTE_MILLIS = 60_000;
const HOUR_MILLIS = 3_600_000;
const DAY_MILLIS = 86_400_000;

const ALERT_TONE = {
  error: {
    wrapper: "border-error/40 bg-error/10",
    text: "text-error",
    meta: "text-error/80",
    detail: "text-error/70",
    action:
      "rounded-md border border-error/40 bg-error/10 px-3 py-1.5 text-sm font-semibold text-error transition-colors duration-150 hover:bg-error/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-error",
  },
  warning: {
    wrapper: "border-warning/40 bg-warning/10",
    text: "text-warning",
    meta: "text-warning/80",
    detail: "text-warning/70",
    action:
      "rounded-md border border-warning/40 bg-warning/10 px-3 py-1.5 text-sm font-semibold text-warning transition-colors duration-150 hover:bg-warning/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warning",
  },
} as const;

interface Alert {
  tone: keyof typeof ALERT_TONE;
  message: string;
}

function format_age(millis: number): string {
  const delta = Math.max(0, millis);

  if (delta < MINUTE_MILLIS) return "przed chwilą";
  if (delta < HOUR_MILLIS)
    return `${Math.floor(delta / MINUTE_MILLIS)} min temu`;
  if (delta < DAY_MILLIS)
    return `${Math.floor(delta / HOUR_MILLIS)} godz. temu`;
  return `${Math.floor(delta / DAY_MILLIS)} dni temu`;
}

/**
 * Strony publiczne wieku danych nie pokazuja, panel musi: po awarii API lista
 * wyglada tak samo jak lista swieza i klamie w sposob nie do wykrycia z ekranu.
 */
function freshness_label(status: EventsSourceStatus): string {
  if (status.fetchedAt === null) {
    return "Z API nie pobrano dotąd żadnych wydarzeń.";
  }

  const clock = format_panel_clock(status.fetchedAt);
  if (clock === null) return "Wiek danych nieznany.";

  const age =
    status.ageMillis === null ? "" : ` — ${format_age(status.ageMillis)}`;
  const suffix = status.stale ? " Dane są przeterminowane." : "";

  return `Dane z ${clock}${age}.${suffix}`;
}

function message_of(cause: unknown): string {
  return cause instanceof Error ? cause.message : "unknown error";
}

function admin_event_href(id: string, action: string): string {
  return `${ADMIN_EVENTS_PATH}/${encodeURIComponent(id)}/${action}`;
}

const notice = read_event_notice(Astro.url.searchParams);

// `force: true`, bo admin wchodzi tu zaraz po zapisie i ma zobaczyc stan bazy,
// a nie zawartosc cache'u sprzed pieciu minut. Przy martwym API wywolanie i tak
// oddaje ostatnie znane wydarzenia — rzuca dopiero, gdy pamiec jest pusta.
let events: TradeFairEvent[] | null = null;
try {
  events = (await load_events({ force: true })).events;
} catch (cause) {
  console.error("[admin/events] events source failed:", message_of(cause));
}

// Status czyta sam cache, bez ruchu w siec — po powyzszym odczycie opisuje juz
// swiezy stan. Blad przy niepustej liscie znaczy: dane sa, ale nie te swieze.
const source_status = get_events_source_status();

const alerts: Alert[] = [];
if (events === null) {
  alerts.push({ tone: "error", message: SOURCE_ERROR });
} else if (source_status.error !== null) {
  alerts.push({ tone: "warning", message: STALE_WARNING });
}

const source_detail =
  source_status.error === null
    ? null
    : `${source_status.error.kind}: ${source_status.error.message}`;

// Rekord odrzucony przez walidacje ksztaltu nie istnieje dla panelu ANI dla
// strony, a w API siedzi dalej — bez tej linii admin szukalby go po liscie.
const rejected =
  source_status.rejected > 0
    ? `API zwróciło ${source_status.rejected} rekordów w kształcie, którego panel nie czyta — nie ma ich ani tutaj, ani na stronie.`
    : null;

// Jedna chwila na caly render: wiersze tabeli nie moga rozjechac sie w czasie.
const now = new Date();
---

<AdminLayout
  title="Wydarzenia"
  description="Panel BlockchainWares — wydarzenia pokazywane na stronie."
>
  <form slot="actions" method="post" action="/api/auth/logout">
    <button type="submit" class={BUTTON_CLASS}>Wyloguj</button>
  </form>

  <div class="space-y-4">
    <header class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-lg font-semibold">Wydarzenia</h1>
        <p class="max-w-prose text-sm text-base-content/60">
          Źródło sekcji „Markets”, banera na stronie głównej i podstron
          <span class="admin-mono">/markets/&lt;id&gt;</span>. Lista jest
          pobierana z API przy każdym wejściu, z pominięciem cache’u.
        </p>
        <p class="admin-tnum mt-1 text-xs text-base-content/60">
          {freshness_label(source_status)}
        </p>
        {
          rejected !== null && (
            <p class="mt-1 max-w-prose text-xs text-warning">{rejected}</p>
          )
        }
      </div>

      <a href={ADMIN_EVENTS_PATH} class={BUTTON_CLASS}>Odśwież listę</a>
    </header>

    {
      notice !== null && (
        <div
          role="status"
          class="rounded-md border border-success/40 bg-success/10 px-4 py-3"
        >
          <p class="text-sm text-success">{NOTICE_MESSAGE[notice.kind]}</p>
          <p class="admin-mono mt-0.5 text-xs break-all text-success/80">
            {notice.id}
          </p>
        </div>
      )
    }

    {
      alerts.map((alert) => (
        <div
          role="alert"
          class:list={[
            "flex flex-wrap items-start justify-between gap-3 rounded-md border px-4 py-3",
            ALERT_TONE[alert.tone].wrapper,
          ]}
        >
          <div class="min-w-0">
            <p class:list={["text-sm", ALERT_TONE[alert.tone].text]}>
              {alert.message}
            </p>
            <p
              class:list={[
                "admin-tnum mt-0.5 text-xs",
                ALERT_TONE[alert.tone].meta,
              ]}
            >
              {freshness_label(source_status)}
            </p>
            {source_detail !== null && (
              <p
                class:list={[
                  "admin-mono mt-0.5 text-xs break-all",
                  ALERT_TONE[alert.tone].detail,
                ]}
              >
                {source_detail}
              </p>
            )}
          </div>

          <a href={ADMIN_EVENTS_PATH} class={ALERT_TONE[alert.tone].action}>
            Ponów próbę
          </a>
        </div>
      ))
    }

    {
      events !== null ? (
        <EventsTable
          events={events}
          now={now}
          createHref={CREATE_HREF}
          editHref={(event) => admin_event_href(event.id, "edit")}
          deleteHref={(event) => admin_event_href(event.id, "delete")}
        />
      ) : (
        // Bez tabeli nie ma jej wlasnego wejscia „Dodaj wydarzenie", a martwy
        // odczyt listy nie musi znaczyc, ze zapis tez nie przejdzie.
        <a href={CREATE_HREF} class={BUTTON_CLASS}>
          Dodaj wydarzenie
        </a>
      )
    }
  </div>
</AdminLayout>
