---
import Layout from "../../layouts/Layout.astro";
import { EventDetail, Navigation, Footer } from "../../components";
import type { RelatedEvent } from "../../components/EventDetail";
import {
  get_event_by_id,
  get_event_name,
  get_event_path,
  get_event_status,
  group_events_by_status,
  MARKETS_PATH,
  type TradeFairEvent,
} from "../../components/events-data";
import { build_event_schema, to_json_ld } from "../../components/event-schema";
import { load_events } from "../../lib/events";

// The page exists to state whether an event is running, so the clock is read per request;
// `get_event_status()` reads the day off it in the event's zone, not in the server's
export const prerender = false;

const OTHER_EVENTS_LIMIT = 3;
const RELATED_ORDER = ["ongoing", "upcoming", "past"] as const;
const DESCRIPTION_LIMIT = 155;
/** Draft with nothing written about it yet — the tag still has to say what the page is */
const FALLBACK_DESCRIPTION =
  "An event on the BlockchainWares calendar — details are still being confirmed.";
/** Same order as the events cache TTL — a crawler retrying sooner hits the same outage */
const RETRY_AFTER_SECONDS = "60";

interface FailureView {
  status: 404 | 503;
  code: string;
  heading: string;
  accent: string;
  title: string;
  description: string;
  body: string;
}

const NOT_FOUND: FailureView = {
  status: 404,
  code: "Error 404",
  heading: "Event",
  accent: "not found",
  title: "Event not found — BlockchainWares",
  description:
    "This event is not on the BlockchainWares calendar. See where you can meet us next.",
  body: "No event of ours sits under this address. The calendar of trade fairs, conferences and workshops is on the markets page.",
};

/**
 * A silent backend is not proof the event is gone, so this is 503 and not 404:
 * a 404 tells search engines to drop a page that outlives the outage.
 */
const SOURCE_DOWN: FailureView = {
  status: 503,
  code: "Error 503",
  heading: "Event details",
  accent: "unavailable right now",
  title: "Event details unavailable — BlockchainWares",
  description:
    "The BlockchainWares events calendar is not answering right now. Try this page again in a moment.",
  body: "Our events calendar is not answering, so we cannot say what is happening under this address. Nothing has been cancelled — this is on our side. Try again in a moment.",
};

const now = new Date();
const current_path = Astro.url.pathname;

// `load_events()` throws only on an empty cache; stale data renders the page as usual
let events: TradeFairEvent[] | null = null;
try {
  events = (await load_events()).events;
} catch (cause) {
  console.error(
    "[markets/:id] events source failed:",
    cause instanceof Error ? cause.message : "unknown error",
  );
}

const found = events
  ? get_event_by_id(Astro.params.id ?? "", events)
  : undefined;

const view = found
  ? ({
      kind: "event",
      event: found,
      status: get_event_status(found, now),
    } as const)
  : ({
      kind: "failure",
      failure: events === null ? SOURCE_DOWN : NOT_FOUND,
    } as const);

if (view.kind === "failure") {
  Astro.response.status = view.failure.status;

  if (view.failure.status === 503) {
    Astro.response.headers.set("Retry-After", RETRY_AFTER_SECONDS);
  }
}

const groups = events ? group_events_by_status(now, events) : null;
const related: RelatedEvent[] = groups
  ? RELATED_ORDER.flatMap((group) =>
      groups[group].map((other) => ({ event: other, status: group })),
    )
      .filter((entry) => entry.event.id !== found?.id)
      .slice(0, OTHER_EVENTS_LIMIT)
  : [];

const title =
  view.kind === "event"
    ? `${get_event_name(view.event)} — BlockchainWares`
    : view.failure.title;
const description =
  view.kind === "event"
    ? truncate(
        view.event.description ?? FALLBACK_DESCRIPTION,
        DESCRIPTION_LIMIT,
      )
    : view.failure.description;

const event_schema =
  view.kind === "event"
    ? build_event_schema(view.event, Astro.site, get_event_path(view.event))
    : null;
const breadcrumb_schema =
  view.kind === "event"
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: new URL("/", Astro.site).href,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Markets & events",
            item: new URL(MARKETS_PATH, Astro.site).href,
          },
          {
            "@type": "ListItem",
            position: 3,
            name: get_event_name(view.event),
            item: new URL(get_event_path(view.event), Astro.site).href,
          },
        ],
      }
    : null;

/** Meta description: whole words up to the limit */
function truncate(text: string, limit: number): string {
  if (text.length <= limit) {
    return text;
  }

  const cut = text.slice(0, limit);
  const boundary = cut.lastIndexOf(" ");

  return `${(boundary > 0 ? cut.slice(0, boundary) : cut).replace(/[.,;:–-]+$/, "")}…`;
}
---

<Layout
  title={title}
  description={description}
  noindex={view.kind === "failure"}
  canonicalPath={view.kind === "event" ? get_event_path(view.event) : undefined}
>
  <Navigation client:load currentPath={current_path} />

  <div class="relative bg-base-100 overflow-clip">
    <div class="absolute inset-0 pointer-events-none z-0">
      <div
        class="absolute top-[-10%] left-[5%] w-[800px] h-[800px] md:w-[1100px] md:h-[1100px] blob-contained"
        style="background: radial-gradient(circle, oklch(72% 0.18 215.221 / 0.14) 0%, transparent 70%);"
      >
      </div>
      <div
        class="absolute top-[40%] left-[55%] w-[900px] h-[900px] md:w-[1200px] md:h-[1200px] blob-contained"
        style="background: radial-gradient(circle, oklch(72% 0.18 215.221 / 0.1) 0%, transparent 70%);"
      >
      </div>
    </div>

    <div class="relative z-[1]">
      {
        view.kind === "event" ? (
          <EventDetail
            event={view.event}
            status={view.status}
            related={related}
          />
        ) : (
          <main class="relative flex min-h-screen items-center justify-center px-4 py-16 md:py-24">
            <div class="mx-auto w-full max-w-2xl text-center">
              <span class="mb-2 block text-xs font-medium uppercase tracking-wider text-secondary md:mb-4 md:text-sm">
                {view.failure.code}
              </span>

              <h1 class="mb-4 text-3xl font-bold leading-tight drop-shadow-lg md:mb-6 md:text-5xl">
                {view.failure.heading}{" "}
                <span class="text-secondary">{view.failure.accent}</span>
              </h1>

              <p class="mx-auto mb-8 max-w-xl text-base leading-relaxed text-base-content/80 md:mb-10 md:text-lg">
                {view.failure.body}
              </p>

              <a
                href={MARKETS_PATH}
                class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-secondary px-6 text-base font-semibold text-secondary-content shadow-md transition-[background-color,box-shadow] duration-150 hover:bg-secondary/90 hover:shadow-lg"
              >
                Markets &amp; events
              </a>
            </div>
          </main>
        )
      }

      <Footer currentPath={current_path} />
    </div>
  </div>

  {
    event_schema && (
      <script type="application/ld+json" set:html={to_json_ld(event_schema)} />
    )
  }
  {
    breadcrumb_schema && (
      <script
        type="application/ld+json"
        set:html={to_json_ld(breadcrumb_schema)}
      />
    )
  }
</Layout>
